          <mxGeometry x="40" y="16" width="200" height="20" as="geometry" />
        </mxCell>
        <mxCell id="hdrR" parent="1" style="text;html=1;align=left;fillColor=none;strokeColor=none;fontStyle=1;fontSize=11;" value="Internal state after the turn" vertex="1">
          <mxGeometry x="430" y="16" width="280" height="20" as="geometry" />
        </mxCell>

        <!-- Turn 1: Patient opening -->
        <mxCell id="t1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;align=left;spacingLeft=8;fontSize=10;" value="&lt;b&gt;Patient:&lt;/b&gt; &quot;My blood sugar has been running high and I&#39;ve been going to the bathroom constantly.&quot;" vertex="1">
          <mxGeometry x="40" y="44" width="340" height="60" as="geometry" />
        </mxCell>
        <mxCell id="a1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;dashed=1;align=left;spacingLeft=8;fontSize=9;" value="recognized: elevated_glucose, polyuria&#xa;routed candidate set: { diabetes, hypertension }&#xa;diabetes confirmed count: 2 / 3" vertex="1">
          <mxGeometry x="430" y="44" width="330" height="60" as="geometry" />
        </mxCell>

        <!-- Turn 2: System question -->
        <mxCell id="t2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;align=left;spacingLeft=8;fontSize=10;" value="&lt;b&gt;System:&lt;/b&gt; &quot;Have you had a blood test showing a high HbA1c level?&quot;" vertex="1">
          <mxGeometry x="40" y="120" width="340" height="44" as="geometry" />
        </mxCell>
        <mxCell id="a2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;dashed=1;align=left;spacingLeft=8;fontSize=9;" value="asking diabetes question -&gt; fact: high_hba1c" vertex="1">
          <mxGeometry x="430" y="120" width="330" height="44" as="geometry" />
        </mxCell>

        <!-- Turn 3: Patient answer (uncertain) -->
        <mxCell id="t3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;align=left;spacingLeft=8;fontSize=10;" value="&lt;b&gt;Patient:&lt;/b&gt; &quot;I haven&#39;t had that test done.&quot;" vertex="1">
          <mxGeometry x="40" y="180" width="340" height="40" as="geometry" />
        </mxCell>
        <mxCell id="a3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;dashed=1;align=left;spacingLeft=8;fontSize=9;" value="answer classified: UNCERTAIN&#xa;high_hba1c not confirmed -- count unchanged: 2 / 3" vertex="1">
          <mxGeometry x="430" y="180" width="330" height="40" as="geometry" />
        </mxCell>

        <!-- Turn 4: System question -->
        <mxCell id="t4" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;align=left;spacingLeft=8;fontSize=10;" value="&lt;b&gt;System:&lt;/b&gt; &quot;Are you feeling unusually thirsty most of the time?&quot;" vertex="1">
          <mxGeometry x="40" y="236" width="340" height="44" as="geometry" />
        </mxCell>
        <mxCell id="a4" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;dashed=1;align=left;spacingLeft=8;fontSize=9;" value="asking diabetes question -&gt; fact: polydipsia" vertex="1">
          <mxGeometry x="430" y="236" width="330" height="44" as="geometry" />
        </mxCell>

        <!-- Turn 5: Patient answer (affirmative) -->
        <mxCell id="t5" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;align=left;spacingLeft=8;fontSize=10;" value="&lt;b&gt;Patient:&lt;/b&gt; &quot;Yes, constantly -- I can&#39;t seem to drink enough water.&quot;" vertex="1">
          <mxGeometry x="40" y="296" width="340" height="44" as="geometry" />
        </mxCell>
        <mxCell id="a5" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;dashed=1;align=left;spacingLeft=8;fontSize=9;" value="answer classified: AFFIRMATIVE&#xa;polydipsia confirmed -- count: 3 / 3 (threshold reached)" vertex="1">
          <mxGeometry x="430" y="296" width="330" height="44" as="geometry" />
        </mxCell>

        <!-- Turn 6: System result -->
        <mxCell id="t6" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;strokeWidth=2;align=left;spacingLeft=8;fontSize=10;" value="&lt;b&gt;System:&lt;/b&gt; &quot;This confirms DIABETES. The confirmed indicators are: reported high blood glucose; urinating far more than usual; and persistent excessive thirst.&quot;" vertex="1">
          <mxGeometry x="40" y="356" width="340" height="70" as="geometry" />
        </mxCell>
        <mxCell id="a6" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;strokeWidth=2;dashed=1;align=left;spacingLeft=8;fontSize=9;" value="threshold reached (3 &#8805; 3) -&gt; DIABETES confirmed&#xa;trace T returned: facts { elevated_glucose, polyuria, polydipsia };&#xa;hypertension never evaluated" vertex="1">
